# Copy to .env and fill in. Never commit .env.

PINECONE_API_KEY=
XAI_API_KEY=

# Optional. Speeds KEV enrichment; without it, ingest skips NVD.
NVD_API_KEY=

# Optional overrides
ATLAS_INDEX_NAME=public-control-atlas
ATLAS_XAI_MODEL=grok-4.6
ATLAS_CACHE_DIR=data/cache
ATLAS_REVIEW_PATH=review/queue.jsonl
ATLAS_RERANK=0
