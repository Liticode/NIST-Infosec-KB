# Copy to .env and fill in. Never commit .env.

# Required only for a live Pinecone Starter index (cloud upsert + search).
PINECONE_API_KEY=

# Optional. Cited natural-language answers via xAI Grok.
# Without it, query uses extractive quotes of retrieved passages.
XAI_API_KEY=

# Optional overrides (defaults are fine for the demo)
ATLAS_INDEX_NAME=public-control-atlas
ATLAS_XAI_MODEL=grok-4.6
ATLAS_CACHE_DIR=data/cache
ATLAS_REVIEW_PATH=review/queue.jsonl
ATLAS_RERANK=0
